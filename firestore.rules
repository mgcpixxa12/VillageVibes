rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roleName) {
      return signedIn() && (
        myUser().get('role','') == roleName ||
        roleName in myUser().get('roles', []) ||
        roleName in myUser().get('roleKeys', [])
      );
    }

    function isLeaderOrHigher() {
      return hasRole('leader') || hasRole('doso') || hasRole('owner') || hasRole('admin') || hasRole('systemAdmin');
    }

    function isDosoOrHigher() {
      return hasRole('doso') || hasRole('owner') || hasRole('admin') || hasRole('systemAdmin');
    }

    // Events: only leadership and owners can access campus event planning records.
    function canManageEventSchool(schoolId) {
      return signedIn() && (isLeaderOrHigher() || myUser().get('teamPosition', '') == 'DOSO') && (
        hasRole('owner') || hasRole('admin') || hasRole('systemAdmin') ||
        schoolId in myUser().get('schoolIds', []) ||
        myUser().get('schoolId', '') == schoolId
      );
    }

    // Campus weather is scoped to the user's assigned school; only leadership can change it.
    match /campusWeather/{schoolId} {
      function campusMember() {
        return signedIn() && (hasRole('owner') || hasRole('admin') || hasRole('systemAdmin') ||
          schoolId in myUser().get('schoolIds', []) || myUser().get('schoolId', '') == schoolId);
      }
      allow read: if campusMember();
      allow create, update: if campusMember() && isLeaderOrHigher() &&
        request.resource.data.get('autoUpdateEnabled', false) == false;
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if signedIn() && canManageEventSchool(resource.data.schoolId);
      allow create: if canManageEventSchool(request.resource.data.schoolId);
      allow update: if canManageEventSchool(resource.data.schoolId) &&
        canManageEventSchool(request.resource.data.schoolId);
      allow delete: if canManageEventSchool(resource.data.schoolId);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isLeaderOrHigher() || isSelf(uid);
      allow update: if isLeaderOrHigher() || isSelf(uid);
      allow delete: if hasRole('owner') || hasRole('admin') || hasRole('systemAdmin');
    }

    // Enrollment affects budget allocations; enforce DOSO authorization on the server.
    match /campusEnrollments/{schoolId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (hasRole('doso') || myUser().get('teamPosition', '') == 'DOSO')
        && (schoolId in myUser().get('schoolIds', []) || myUser().get('schoolId', '') == schoolId);
      allow delete: if false;
    }

    match /appSettings/{docId} {
      allow read: if signedIn();
      allow write: if isDosoOrHigher();
    }

    match /coreChampionRounds/{monthKey} {
      allow read: if signedIn();
      allow create: if isDosoOrHigher();
      allow update: if signedIn();
      allow delete: if isDosoOrHigher();
    }

    function huddleMember(hid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/huddles/$(hid)).data.members;
    }
    match /huddles/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && request.auth.uid in resource.data.members && request.resource.data.members == resource.data.members && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes','proposals','imageIds','updatedAt']) || isDosoOrHigher());
      match /visuals/{vid} {
        allow read, create: if huddleMember(hid);
      }
    }
    match /huddleSidebars/{sid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members && huddleMember(request.resource.data.huddleId) && request.resource.data.members.hasOnly(get(/databases/$(database)/documents/huddles/$(request.resource.data.huddleId)).data.members);
      allow update: if signedIn() && request.auth.uid in resource.data.members && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes']);
      allow delete: if signedIn() && request.auth.uid in resource.data.members && huddleMember(resource.data.huddleId);
    }
    // Anonymous public form submissions: only published, enabled forms are readable.
    match /villagePublicForms/{formId} {
      allow read: if true;
      allow create, delete: if isLeaderOrHigher();
      allow update: if isLeaderOrHigher() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']) && request.resource.data.claimed is map && resource.data.acceptResponses == true);
    }
    match /villagePublicResponses/{responseId} {
      allow create: if request.resource.data.keys().hasOnly(['publicFormId','sourceFormId','answers','submittedAt'])
        && request.resource.data.publicFormId is string
        && request.resource.data.sourceFormId is string
        && request.resource.data.answers is map
        && request.resource.data.submittedAt == request.time
        && exists(/databases/$(database)/documents/villagePublicForms/$(request.resource.data.publicFormId))
        && get(/databases/$(database)/documents/villagePublicForms/$(request.resource.data.publicFormId)).data.acceptResponses == true
        && get(/databases/$(database)/documents/villagePublicForms/$(request.resource.data.publicFormId)).data.sourceFormId == request.resource.data.sourceFormId;
      allow read, delete: if isLeaderOrHigher();
    }
    match /{top}/{document=**} {
      allow read, write: if signedIn() && !(top in ['huddles','huddleSidebars','villagePublicForms','villagePublicResponses','campusEnrollments']);
    }
  }
}
